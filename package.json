{
  "name": "unalgorithm",
  "private": true,
  "description": "unAlgorithm: see the posts you came for. An open-source feed curator for LinkedIn and Facebook.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @unalgorithm/extension dev",
    "dev:fb": "pnpm --filter @unalgorithm/extension dev:fb",
    "dev:edge": "pnpm --filter @unalgorithm/extension dev:edge",
    "dev:firefox": "pnpm --filter @unalgorithm/extension dev:firefox",
    "build": "pnpm --filter @unalgorithm/extension build",
    "build:edge": "pnpm --filter @unalgorithm/extension build:edge",
    "build:firefox": "pnpm --filter @unalgorithm/extension build:firefox",
    "zip": "pnpm --filter @unalgorithm/extension zip:all",
    "zip:chrome": "pnpm --filter @unalgorithm/extension zip",
    "zip:edge": "pnpm --filter @unalgorithm/extension zip:edge",
    "zip:firefox": "pnpm --filter @unalgorithm/extension zip:firefox",
    "lint:firefox": "pnpm --filter @unalgorithm/extension lint:firefox",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "e2e": "pnpm --filter @unalgorithm/extension e2e",
    "e2e:edge": "pnpm --filter @unalgorithm/extension e2e:edge",
    "e2e:firefox": "pnpm --filter @unalgorithm/extension e2e:firefox",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "docs:site": "node packages/research/eval/publish.ts",
    "eval:factcheck": "node packages/research/eval/cli.ts",
    "eval:trust": "node apps/server/src/cli/trust-eval.ts",
    "changeset": "changeset",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "scan:public": "node scripts/scan-public-repo.mjs",
    "licenses:server": "node scripts/check-server-licenses.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  }
}
