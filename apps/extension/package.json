{
  "name": "@unalgorithm/extension",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "unAlgorithm browser extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:fb": "cross-env UA_START=facebook wxt",
    "dev:edge": "cross-env UA_DEV_PROFILE=edge-data wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode e2e",
    "build:e2e:edge": "wxt build -b edge --mode e2e",
    "build:e2e:firefox": "wxt build -b firefox --mode e2e",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "cd ../.. && wxt zip apps/extension -b firefox",
    "zip:sideload": "cross-env UA_SIDELOAD=1 wxt zip && cross-env UA_SIDELOAD=1 wxt build -b firefox",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox && pnpm zip:sideload",
    "lint:firefox": "node ../../scripts/check-firefox-lint.mjs .output/firefox-mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "e2e": "pnpm build:e2e && playwright test --project=chromium",
    "e2e:edge": "pnpm build:e2e:edge && playwright test --project=edge",
    "e2e:firefox": "pnpm build:e2e:firefox && playwright test --project=firefox",
    "store:screens": "pnpm build:e2e && cross-env UA_STORE=1 playwright test --project=chromium e2e/store.spec.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@unalgorithm/ai": "workspace:*",
    "@unalgorithm/core": "workspace:*",
    "@unalgorithm/outlets": "workspace:*",
    "@unalgorithm/platforms": "workspace:*",
    "@unalgorithm/protocol": "workspace:*",
    "@unalgorithm/research": "workspace:*",
    "@unalgorithm/sync": "workspace:*",
    "@unalgorithm/ui": "workspace:*",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@puppeteer/browsers": "3.2.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "~4.14.0",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "puppeteer-core": "25.14.0",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}
