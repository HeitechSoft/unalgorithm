{
  "name": "@unalgorithm/extension",
  "version": "0.2.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "UnAlgorithm browser extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:fb": "cross-env UA_START=facebook wxt",
    "build": "node ../../packages/outlets/src/cli.ts check && wxt build",
    "build:e2e": "node ../../packages/outlets/src/cli.ts check && wxt build --mode e2e",
    "zip": "node ../../packages/outlets/src/cli.ts check && wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "e2e": "pnpm build:e2e && playwright test",
    "store:screens": "pnpm build:e2e && cross-env UA_STORE=1 playwright test e2e/store.spec.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@unalgorithm/ai": "workspace:*",
    "@unalgorithm/core": "workspace:*",
    "@unalgorithm/outlets": "workspace:*",
    "@unalgorithm/platforms": "workspace:*",
    "@unalgorithm/protocol": "workspace:*",
    "@unalgorithm/research": "workspace:*",
    "@unalgorithm/sync": "workspace:*",
    "@unalgorithm/ui": "workspace:*",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "web-ext": "^10.7.0",
    "wxt": "0.21.4"
  }
}
