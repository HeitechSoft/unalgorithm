# UnAlgorithm Feed server settings for compose.yaml. Copy this file to .env in this folder, fill it in, and keep the
# copy private: it holds your keys and passwords. Never commit it. A blank value counts as unset, and a commented
# line shows the default; remove its # to change it.
#
# Put a value that contains $ in single quotes, as in SMTP_PASSWORD='ab$cd': Compose reads $cd in an unquoted or
# double-quoted value as a variable and replaces it, usually with nothing.
#
# Check the settings without starting the server:
#   docker compose run --rm --no-deps server node apps/server/src/cli/check-config.ts

# --- Compose ---

# The server release to run, such as 0.1.0; unset runs latest. Pin a release and change it to upgrade.
# UNALGORITHM_VERSION=latest

# The address the server's port is published on. Keep 127.0.0.1, with the caddy profile or your own HTTPS proxy in front.
# BIND_ADDRESS=127.0.0.1

# Host port published on BIND_ADDRESS; inside the container the server always listens on 8787.
# PORT=8787

# Optional services, comma-separated: caddy (HTTPS for PUBLIC_URL's host on ports 80 and 443; set TRUST_PROXY=one-hop with it) and ollama (a local model next to the server; see AI_BASE_URL).
# COMPOSE_PROFILES=

# The database password: letters and digits only (it is placed in a URL); generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# When the nightly backup runs, HH:MM in UTC.
# BACKUP_TIME=03:17

# How many nightly backups stay in the backups folder; older ones are deleted.
# BACKUP_KEEP=14

# Where backups are written on this machine; copy them somewhere else too (docs/self-hosting.md).
# BACKUP_DIR=./backups

# Set by compose.yaml; any value here is ignored.
# HOST=
# WEB_DIST=
# DATABASE_URL=
# BACKUP_STATUS_DIR=

# --- This server ---

# The https origin people and the extension reach this server on, without a path or trailing slash (http only for localhost). Passkeys need a domain name or localhost here, not an IP address.
PUBLIC_URL=https://unalgorithm.example.org

# The name people see on the sign-in page, up to 80 characters; do not use 'UnAlgorithm Cloud' (TRADEMARKS.md). Unset: the PUBLIC_URL host, so set it when that host is over 80 characters.
INSTANCE_NAME=

# Signs sessions and tokens: at least 32 characters; generate with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=

# Who may create an account: email addresses and @domain entries, comma-separated. Empty: nobody can.
SIGNUP_ALLOWLIST=

# Extension ids allowed to sign in, comma-separated. Unset: the UnAlgorithm Feed ids this release knows.
# EXTENSION_IDS=

# one-hop when an HTTPS proxy in front sets X-Forwarded-For (the caddy profile does; its last entry is then the client address); none otherwise.
# TRUST_PROXY=none

# Where people get the source of the server you run (AGPL section 13). Unset: this release's; set it if you modify it.
# SOURCE_URL=

# off for a self-hosted server: nobody is charged. module loads the billing module at BILLING_MODULE when the server starts, and a module that cannot be loaded stops the start; the module reads its own BILLING_* variables, set in this file too.
# BILLING=off

# The billing module's absolute path, a .ts, .mts, .js or .mjs file; only with BILLING=module.
# BILLING_MODULE=

# --- Mail (sign-in codes) ---

# Your mail provider's SMTP server.
SMTP_HOST=smtp.example.org

# The SMTP port.
# SMTP_PORT=587

# starttls, tls (usually port 465), or none (only for a mail server on this machine or in this Compose project).
# SMTP_SECURE=starttls

# The SMTP login; set both or neither.
SMTP_USER=
SMTP_PASSWORD=

# The address sign-in codes come from.
MAIL_FROM=signin@example.org

# The sender name on sign-in codes. Unset: the instance name.
# MAIL_FROM_NAME=

# --- Sign in with Google (optional) ---

# Optional: sign in with Google. Create an OAuth client (web application) whose authorized redirect URI is <PUBLIC_URL>/api/auth/callback/google, with only the openid and email scopes. Set both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI provider ---

# anthropic, or openai-compatible for a model on hardware you control (such as Ollama).
AI_PROVIDER=anthropic

# Your Anthropic API key (anthropic only).
AI_API_KEY=

# The model. Unset with anthropic: the default model; openai-compatible needs one: with the ollama profile, a model you pulled, such as llama3.2:3b.
# AI_MODEL=

# The openai-compatible endpoint, ending in /v1; with the ollama profile, http://ollama:11434/v1. Leave unset with anthropic.
# AI_BASE_URL=

# vendor-zdr for anthropic (zero data retention); self-hosted for openai-compatible: a model on hardware you control (the ollama profile).
# AI_DATA_POLICY=vendor-zdr

# --- Fact-check (Labs) ---

# on lets people fact-check public posts; off (the default) turns it off, and then every other fact-check setting but the two limits must be unset.
# FACTCHECK=off

# The research model (anthropic only, with web search); unset: claude-sonnet-5-5. Leave unset when SEARCH_PROVIDER is set.
# AI_RESEARCH_MODEL=

# The model that writes the verdicts; unset: claude-sonnet-5-5 with anthropic, AI_MODEL with openai-compatible.
# AI_SYNTHESIS_MODEL=

# searxng, brave or tavily to research with that search engine; unset: Anthropic web search. openai-compatible needs one; BILLING=module allows none.
# SEARCH_PROVIDER=

# Your SearXNG instance's address, http or https (searxng only).
# SEARCH_URL=

# Your Brave Search or Tavily API key (brave and tavily only).
# SEARCH_API_KEY=

# Fact-checks each person may run per UTC day when BILLING is off; 0 allows none.
# USER_DAILY_CHECK_CAP=10

# More addresses the link check never reaches, as IPs or ip/prefix ranges, comma-separated; private and local ranges are always refused.
# EGRESS_DENY=

# --- Limits ---

# The share of the eval set (0 to 1) the AI route must agree with before it serves anyone; see route-eval.
# ROUTE_EVAL_MIN_AGREEMENT=0.8

# Posts each person may have classified per UTC day; the user-cap command changes it for one person.
# USER_DAILY_POST_CAP=1000

# Classify requests each person may make per minute.
# USER_REQUESTS_PER_MINUTE=30

# Daily AI spend in dollars at which classification stops for everyone until the next UTC day.
# DAILY_SPEND_LIMIT_USD=5

# --- Alerts ---

# Free disk space in GB below which the disk-free-low alert opens; 0 turns it off.
# ALERT_DISK_FREE_MIN_GB=5

# Database size in GB above which the database-size-high alert opens; 0 turns it off.
# ALERT_DATABASE_MAX_GB=10

# Error log lines in 15 minutes at which the errors-high alert opens; 0 turns it off.
# ALERT_ERRORS_PER_15M=20

# Hours since a backup's last success after which its backup alert opens; 0 alerts on failed runs only.
# ALERT_BACKUP_MAX_AGE_HOURS=26

# Who gets an email when an alert opens, is still open a day later or closes: unset emails this server's admins; none sends no email; or up to 20 addresses, comma-separated (ops@example.org,oncall@example.org).
# ALERT_EMAIL=

# A URL that also gets each alert notification as a JSON POST (a Slack, Mattermost or Discord incoming webhook shows its text as is). It often holds a token: keep it secret. Unset: no webhook.
# ALERT_WEBHOOK_URL=

# A token for GET /metrics (Prometheus text) for your monitoring tool: at least 32 characters; generate with `openssl rand -hex 32`. Unset: no metrics endpoint.
# METRICS_TOKEN=

# --- Runtime ---

# debug, info, warn or error.
# LOG_LEVEL=info

# Leave unset: the server refuses to start with Better Auth telemetry on (0 and false are accepted).
# BETTER_AUTH_TELEMETRY=

# Leave unset: the server refuses to start while it is set, because it would add headers to every AI request.
# ANTHROPIC_CUSTOM_HEADERS=
