                      "refusal",
                      "truncated",
                      "bad-request",
                      "context-overflow",
                      "unsupported",
                      "not-available",
                      "timeout",
                      "network",
                      "cap-reached",
                      "insufficient-credits",
                      "auth-required",
                      "unknown"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": ["code", "message"]
              }
            }
          }
        },
        "401": {
