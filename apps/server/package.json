{
  "name": "@unalgorithm/server",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Self-hostable server for unAlgorithm Feed: email sign-in and AI classification for the extension",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "start": "node --import ./src/require-node.js src/index.ts",
    "dev": "node --import ./src/require-node.js --watch src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "check-config": "node --import ./src/require-node.js src/cli/check-config.ts",
    "route-eval": "node --import ./src/require-node.js src/cli/route-eval.ts",
    "user-cap": "node --import ./src/require-node.js src/cli/user-cap.ts",
    "billing": "node --import ./src/require-node.js src/cli/billing.ts",
    "sync:new-epoch": "node --import ./src/require-node.js src/cli/sync-new-epoch.ts",
    "setup-link": "node --import ./src/require-node.js src/cli/setup-link.ts",
    "alerts": "node --import ./src/require-node.js src/cli/alerts.ts",
    "transparency": "node --import ./src/require-node.js src/cli/transparency.ts",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config auth.cli.ts --output src/db/auth-schema.ts --adapter drizzle --dialect postgresql --yes && pnpm run db:generate"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@unalgorithm/ai": "workspace:*",
    "@unalgorithm/core": "workspace:*",
    "@unalgorithm/outlets": "workspace:*",
    "@unalgorithm/protocol": "workspace:*",
    "@unalgorithm/research": "workspace:*",
    "@unalgorithm/sync": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/pg": "^8",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.12",
    "yaml": "^2.9.1"
  }
}
